% ---
% comprimento do traco de assinatura e do texto abaixo dele
\newlength{\UFFsignwidth}
\setlength{\UFFsignwidth}{12.25cm}
% ---
% espessura do traco
\newlength{\UFFsignthickness}
\setlength{\UFFsignthickness}{1pt}
% ---
% espaco entre o traco de assinatura e o texto anterior
\newlength{\UFFsignskip}
\setlength{\UFFsignskip}{0.8cm}
% ---
% assinatura com traco
\newcommand{\UFFsign}[1]{%
  \parbox[t]{\UFFsignwidth}{\singlespacing{
    \vspace*{1.25\UFFsignskip}
    \rule{\UFFsignwidth}{\UFFsignthickness}\par
    \nopagebreak #1\par}
  }
}
% ---
% assinatura sem traco
\newcommand{\UFFunsign}[1]{%
  \parbox[t]{\UFFsignwidth}{\singlespacing{
    \nopagebreak #1\par
    \vspace*{\UFFsignskip}}
  }
}
% ---
% assinatura com estrela
\newcommand{\UFFucsign}[2]%
  {\par\hspace{1.5cm}\UFFunsign{#1\\ #2}}
% ---
% assinatura sem estrela
\newcommand{\UFFcsign}[2]%
  {\begingroup\par\hspace{1.5cm}\UFFsign{#1\\ #2}\endgroup}  
% ---

% ---
% Comando \assinatura
% ---
\makeatletter
\newcommand{\assinatura}{\@ifstar{\UFFucsign}{\UFFcsign}}
\makeatother
