% Abaixo temos o código que fará o programa ler as iniciais do nome da pessoa escrevendo as preposições do nome por extenso

% Código pra verificar se a letra está em uppercase
\makeatletter
\def\instring#1#2{TT\fi\begingroup
  \edef\x{\endgroup\noexpand\in@{#1}{#2}}\x\ifin@}
%
\def\isuppercase#1{%
  \instring{#1}{AÂBCÇDEFGĞHIİÎJKLMNOÖÔPRSŞTUÜÛVYZ}%
}%
\makeatother

% Código que vai puxar as iniciais do nome do autor, escrevendo as preposições do nome por extenso
\def\firstletters{\bgroup \catcode`-=10 \catcode`(=10 \filA}
\def\filA#1{\filB#1 {\end} }
\def\filB#1#2 {
\ifx
    \end#1\space\egroup
\else
    \if\isuppercase{#1}
        #1.
    \else 
        #1#2
    \fi
    \expandafter\filB
\fi} 

